# Supabase project (service role key — never expose to client)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Shared secret between Edge Function and this worker
WORKER_SECRET=<random-32-char-string>

# Where the built Vite app is served (for Playwright to open render.html)
APP_ORIGIN=https://mapimages.travlr.earth

# Port (Fly.io sets this automatically)
PORT=3001
